<!DOCTYPE html>
<html>
<head>
  <title>HATCH Dino Renderer Test</title>
</head>
<body>
  <h1>Your Dino (Seed Verified Locally)</h1>
  <canvas id="canvas" width="512" height="512" style="image-rendering: pixelated; border: 2px solid black; background: #000;"></canvas>
  <pre id="traits" style="margin-top: 20px; white-space: pre-wrap;"></pre>

  <script>
    // === /* ════════════════════════════════════════════════════════════
   HATCH v2 — arcade design system + sprite compositing
   ════════════════════════════════════════════════════════════ */

:root {
  --bg:        #0a0a0a;
  --screen:    #050505;
  --panel:     #0f0f0f;
  --neon:      #00ff66;
  --neon-dim:  #00aa44;
  --neon-low:  #003322;
  --amber:     #ffaa00;
  --rare:      #b266ff;
  --legendary: #ffd700;
  --danger:    #ff3838;
  --text:      #e8e8e8;
  --dim:       #666666;
  --border:    var(--neon);

  --serif:     'Press Start 2P', monospace;
  --body:      'VT323', monospace;
  --mono:      'JetBrains Mono', ui-monospace, monospace;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--body);
  font-size: 18px;
  line-height: 1.4;
  -webkit-font-smoothing: none;
  font-smooth: never;
  text-rendering: optimizeSpeed;
  min-height: 100vh;
}

/* CRT scanline overlay (subtle) */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 100;
  background: repeating-linear-gradient(
    0deg,
    rgba(0,0,0,0.18),
    rgba(0,0,0,0.18) 1px,
    transparent 1px,
    transparent 3px
  );
  opacity: 0.55;
}

/* CRT vignette (subtle dark corners) */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 99;
  background: radial-gradient(circle at center, transparent 60%, rgba(0,0,0,0.4) 100%);
}

a {
  color: var(--neon);
  text-decoration: none;
  transition: color 0.1s, background 0.1s;
}
a:hover {
  color: var(--text);
  background: var(--neon);
}

img, svg {
  image-rendering: pixelated;
  image-rendering: crisp-edges;
  image-rendering: -moz-crisp-edges;
  display: block;
}

/* ═══════════════════════════════════════════════════════════
   TOP NAV
   ═══════════════════════════════════════════════════════════ */
.topnav {
  border-bottom: 4px solid var(--neon);
  background: var(--screen);
  position: sticky;
  top: 0;
  z-index: 50;
  box-shadow: 0 4px 0 var(--neon-low);
}
.topnav-inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 14px 24px;
  display: flex;
  align-items: center;
  gap: 24px;
}

.brand {
  font-family: var(--serif);
  font-size: 18px;
  color: var(--text);
  letter-spacing: 1px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.brand:hover { background: transparent; color: var(--text); }
.brand .dot { color: var(--neon); }
.brand img.icon {
  width: 32px;
  height: 32px;
}

.nav-links {
  display: flex;
  gap: 4px;
  flex: 1;
}
.nav-link {
  font-family: var(--serif);
  font-size: 10px;
  letter-spacing: 1.5px;
  padding: 10px 14px;
  color: var(--dim);
  border: 2px solid transparent;
  transition: color 0.1s, border-color 0.1s;
}
.nav-link:hover {
  color: var(--neon);
  background: transparent;
}
.nav-link.active {
  color: var(--neon);
  border-color: var(--neon);
}

.nav-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

.menu-btn {
  display: none;
  background: transparent;
  border: 2px solid var(--neon);
  color: var(--neon);
  width: 36px;
  height: 36px;
  cursor: pointer;
  font-size: 18px;
}

@media (max-width: 880px) {
  .menu-btn { display: flex; align-items: center; justify-content: center; }
  .nav-links {
    position: absolute;
    top: 100%;
    left: 0; right: 0;
    background: var(--screen);
    border-bottom: 4px solid var(--neon);
    flex-direction: column;
    padding: 12px;
    display: none;
  }
  .nav-links.open { display: flex; }
}

/* ═══════════════════════════════════════════════════════════
   BUTTONS
   ═══════════════════════════════════════════════════════════ */
.btn {
  display: inline-block;
  font-family: var(--serif);
  font-size: 11px;
  letter-spacing: 2px;
  padding: 12px 22px;
  border: 4px solid;
  cursor: pointer;
  text-decoration: none;
  text-transform: uppercase;
  background: transparent;
  transition: transform 0.05s, box-shadow 0.05s;
  position: relative;
}
.btn-primary {
  background: var(--neon);
  color: var(--screen);
  border-color: var(--neon);
  box-shadow: 4px 4px 0 var(--text);
}
.btn-primary:hover { background: var(--neon); color: var(--screen); }
.btn-primary:active {
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0 var(--text);
}
.btn-line {
  color: var(--neon);
  border-color: var(--neon);
}
.btn-line:hover { background: var(--neon); color: var(--screen); }
.btn-amber {
  background: var(--amber);
  color: var(--screen);
  border-color: var(--amber);
  box-shadow: 4px 4px 0 var(--text);
}
.btn-amber:active {
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0 var(--text);
}

/* ═══════════════════════════════════════════════════════════
   HEARTBEAT BAR
   ═══════════════════════════════════════════════════════════ */
.heartbeat {
  background: var(--screen);
  border-bottom: 2px solid var(--neon-dim);
  padding: 8px 0;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  overflow-x: auto;
}
.hb-inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  gap: 24px;
  align-items: center;
  white-space: nowrap;
}
.hb-item { color: var(--dim); }
.hb-val { color: var(--text); font-weight: 500; }
.hb-val.neon { color: var(--neon); }
.hb-val.amber { color: var(--amber); }
.hb-dot {
  display: inline-block;
  width: 8px; height: 8px;
  background: var(--neon);
  margin-right: 6px;
  animation: pulse 1.5s ease-in-out infinite;
}
.hb-spacer { flex: 1; }
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.3; }
}

/* ═══════════════════════════════════════════════════════════
   LAYOUT
   ═══════════════════════════════════════════════════════════ */
.canvas {
  max-width: 1400px;
  margin: 0 auto;
  padding: 32px 24px;
}

.page-head {
  border-bottom: 4px solid var(--neon);
  padding-bottom: 24px;
  margin-bottom: 32px;
}
.page-tag {
  font-family: var(--serif);
  font-size: 9px;
  letter-spacing: 2px;
  color: var(--neon);
  margin-bottom: 12px;
  text-transform: uppercase;
}
.page-head h1 {
  font-family: var(--serif);
  font-size: 36px;
  color: var(--text);
  letter-spacing: 2px;
  line-height: 1.3;
  text-transform: uppercase;
}
.page-head h1 .neon { color: var(--neon); }
.page-head h1 .amber { color: var(--amber); }
.page-head .lead {
  font-family: var(--body);
  font-size: 22px;
  color: var(--dim);
  margin-top: 12px;
}

/* ═══════════════════════════════════════════════════════════
   STAT GRID
   ═══════════════════════════════════════════════════════════ */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0;
  border: 4px solid var(--neon);
  margin-bottom: 24px;
}
@media (max-width: 880px) {
  .stat-grid { grid-template-columns: repeat(2, 1fr); }
}
.stat {
  padding: 16px 18px;
  background: var(--screen);
  border-right: 2px solid var(--neon-dim);
}
.stat:last-child { border-right: none; }
.stat .lbl {
  font-family: var(--serif);
  font-size: 8px;
  letter-spacing: 2px;
  color: var(--dim);
  margin-bottom: 8px;
  text-transform: uppercase;
}
.stat .val {
  font-family: var(--serif);
  font-size: 22px;
  color: var(--text);
  letter-spacing: 1px;
}
.stat .val.neon { color: var(--neon); }
.stat .val.amber { color: var(--amber); }

/* ═══════════════════════════════════════════════════════════
   FILTER BAR
   ═══════════════════════════════════════════════════════════ */
.filter-bar {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  align-items: center;
  padding: 14px 18px;
  background: var(--screen);
  border: 4px solid var(--neon);
  margin-bottom: 18px;
}
.filter-bar select, .filter-bar input {
  background: var(--screen);
  color: var(--text);
  border: 2px solid var(--neon);
  padding: 8px 12px;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 1px;
  outline: none;
  border-radius: 0;
}
.filter-bar select:focus, .filter-bar input:focus {
  border-color: var(--amber);
  color: var(--amber);
}
.filter-bar label {
  font-family: var(--serif);
  font-size: 9px;
  letter-spacing: 2px;
  color: var(--dim);
  text-transform: uppercase;
}

/* ═══════════════════════════════════════════════════════════
   HATCH SPRITE FRAME (the new compositing system)
   ═══════════════════════════════════════════════════════════ */
.hatch-frame {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  background: var(--screen);
  isolation: isolate;
}

.hatch-scenery {
  position: absolute;
  inset: 0;
  z-index: 1;
}
.hatch-scenery img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.85;
}

.hatch-sprite {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hatch-sprite img {
  width: 75%;
  height: 75%;
  object-fit: contain;
}

/* ─── Aura overlays (CSS-only, no PNG) ──────────────────── */
.hatch-aura-fx {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
}
.hatch-aura-fire .hatch-aura-fx {
  background: radial-gradient(circle at 50% 70%, rgba(255,80,32,0.5) 0%, transparent 60%);
  animation: flicker 1s steps(3) infinite;
}
.hatch-aura-electric .hatch-aura-fx {
  background:
    linear-gradient(75deg, transparent 48%, rgba(255,238,48,0.6) 50%, transparent 52%),
    linear-gradient(-65deg, transparent 48%, rgba(96,232,255,0.4) 50%, transparent 52%);
  animation: zap 0.5s steps(2) infinite;
}
.hatch-aura-rainbow .hatch-aura-fx {
  background: repeating-linear-gradient(
    0deg,
    rgba(255,80,80,0.15) 0px, rgba(255,80,80,0.15) 4px,
    rgba(255,144,80,0.15) 4px, rgba(255,144,80,0.15) 8px,
    rgba(255,224,80,0.15) 8px, rgba(255,224,80,0.15) 12px,
    rgba(80,208,80,0.15) 12px, rgba(80,208,80,0.15) 16px,
    rgba(80,144,255,0.15) 16px, rgba(80,144,255,0.15) 20px,
    rgba(144,80,255,0.15) 20px, rgba(144,80,255,0.15) 24px
  );
  animation: rainbow-shift 3s linear infinite;
}
.hatch-aura-smoke .hatch-aura-fx {
  background: radial-gradient(circle at 50% 100%, rgba(60,60,60,0.6) 0%, transparent 50%);
}
.hatch-aura-frost .hatch-aura-fx {
  background: radial-gradient(circle at 50% 50%, rgba(160,224,255,0.4) 0%, transparent 65%);
  box-shadow: inset 0 0 80px rgba(160,224,255,0.5);
}
.hatch-aura-shadow .hatch-aura-fx {
  background: radial-gradient(circle at 50% 70%, rgba(0,0,0,0.6) 0%, transparent 50%);
  box-shadow: inset 0 0 60px rgba(0,0,0,0.7);
}
.hatch-aura-glow .hatch-aura-fx {
  background: radial-gradient(circle at 50% 50%, rgba(0,255,102,0.35) 0%, transparent 65%);
  animation: aura-pulse 2s ease-in-out infinite;
}

/* New auras (8-15) */
.hatch-aura-sparkle .hatch-aura-fx {
  background-image:
    radial-gradient(circle at 20% 30%, rgba(255,255,255,0.8) 0px, transparent 2px),
    radial-gradient(circle at 70% 60%, rgba(255,255,255,0.7) 0px, transparent 2px),
    radial-gradient(circle at 40% 80%, rgba(255,215,0,0.7) 0px, transparent 2px),
    radial-gradient(circle at 85% 25%, rgba(255,255,255,0.6) 0px, transparent 2px),
    radial-gradient(circle at 15% 70%, rgba(255,215,0,0.6) 0px, transparent 2px);
  animation: sparkle-twinkle 1.4s ease-in-out infinite;
}
.hatch-aura-haze .hatch-aura-fx {
  background:
    radial-gradient(ellipse at 50% 80%, rgba(180,150,200,0.4) 0%, transparent 60%),
    radial-gradient(ellipse at 50% 30%, rgba(120,180,200,0.2) 0%, transparent 70%);
}
.hatch-aura-embers .hatch-aura-fx {
  background-image:
    radial-gradient(circle at 30% 80%, rgba(255,100,40,0.7) 0px, transparent 3px),
    radial-gradient(circle at 60% 70%, rgba(255,160,40,0.7) 0px, transparent 3px),
    radial-gradient(circle at 50% 60%, rgba(255,80,30,0.6) 0px, transparent 3px),
    radial-gradient(circle at 75% 85%, rgba(255,140,40,0.6) 0px, transparent 3px);
  animation: embers-rise 2s ease-in-out infinite;
}
.hatch-aura-snowfall .hatch-aura-fx {
  background-image:
    radial-gradient(circle at 20% 0%, rgba(255,255,255,0.9) 0px, transparent 2px),
    radial-gradient(circle at 50% 0%, rgba(255,255,255,0.8) 0px, transparent 2px),
    radial-gradient(circle at 80% 0%, rgba(255,255,255,0.85) 0px, transparent 2px),
    radial-gradient(circle at 35% 0%, rgba(255,255,255,0.7) 0px, transparent 2px),
    radial-gradient(circle at 65% 0%, rgba(255,255,255,0.85) 0px, transparent 2px);
  animation: snowfall-down 3s linear infinite;
  background-size: 100% 200%;
}
.hatch-aura-lightning-bolt .hatch-aura-fx {
  background:
    linear-gradient(125deg, transparent 47%, rgba(255,255,255,0.9) 49%, rgba(120,180,255,0.8) 51%, transparent 53%),
    linear-gradient(-115deg, transparent 47%, rgba(120,180,255,0.5) 49%, transparent 51%);
  animation: zap 0.3s steps(2) infinite;
}
.hatch-aura-voidaura .hatch-aura-fx {
  background:
    radial-gradient(circle at 50% 50%, rgba(0,0,0,0.85) 0%, rgba(80,0,120,0.4) 40%, transparent 70%);
  box-shadow: inset 0 0 90px rgba(120,0,180,0.6);
  animation: voidaura-pulse 3s ease-in-out infinite;
}
.hatch-aura-goldaura .hatch-aura-fx {
  background:
    radial-gradient(circle at 50% 50%, rgba(255,215,0,0.5) 0%, transparent 65%);
  box-shadow: inset 0 0 70px rgba(255,215,0,0.7);
  animation: aura-pulse 1.5s ease-in-out infinite;
}
.hatch-aura-pulse .hatch-aura-fx {
  background: radial-gradient(circle at 50% 50%, rgba(0,255,102,0.5) 0%, transparent 50%);
  animation: pulse-grow 1.2s ease-in-out infinite;
}

@keyframes sparkle-twinkle {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.4; transform: scale(0.95); }
}
@keyframes embers-rise {
  0%   { transform: translateY(10px); opacity: 0.7; }
  50%  { transform: translateY(-5px); opacity: 1; }
  100% { transform: translateY(-15px); opacity: 0; }
}
@keyframes snowfall-down {
  from { background-position: 0 -100%; }
  to   { background-position: 0 100%; }
}
@keyframes voidaura-pulse {
  0%, 100% { opacity: 0.7; transform: scale(1); }
  50%      { opacity: 1; transform: scale(1.05); }
}
@keyframes pulse-grow {
  0%, 100% { transform: scale(0.9); opacity: 0.7; }
  50%      { transform: scale(1.1); opacity: 1; }
}

/* ─── PATTERN OVERLAYS ─────────────────────────────── */
/* Patterns are body-texture overlays — they should sit ON the dino,
   not dominate the frame. Sized to roughly match the dino sprite (50%),
   masked-blended so the texture only shows where there's dino underneath. */
.hatch-pattern {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hatch-pattern img {
  width: 50%;
  height: 50%;
  object-fit: contain;
  mix-blend-mode: overlay;
  opacity: 0.4;
}
/* Pattern-specific blend modes (matrix/glitch/static look better in screen) */
.hatch-pattern-matrix img,
.hatch-pattern-glitch img,
.hatch-pattern-static img,
.hatch-pattern-lightning img,
.hatch-pattern-circuit img { mix-blend-mode: screen; opacity: 0.5; }
/* Subtle metallic patterns get a multiply blend */
.hatch-pattern-metal img,
.hatch-pattern-scales img,
.hatch-pattern-fish-scale img { mix-blend-mode: multiply; opacity: 0.4; }
/* Animated patterns */
.hatch-pattern-static img { animation: static-flicker 0.15s steps(3) infinite; }
.hatch-pattern-glitch img { animation: glitch-jitter 0.3s steps(2) infinite; }
.hatch-pattern-lightning img { animation: zap 0.5s steps(2) infinite; }

@keyframes static-flicker {
  0%, 100% { opacity: 0.5; }
  50%      { opacity: 0.3; }
}
@keyframes glitch-jitter {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(2px); }
}

/* ─── ACCESSORY OVERLAYS ───────────────────────────── */
/* Accessories sit on the upper-third of the frame (roughly the dino's head).
   Sized smaller than the dino body so they look worn, not covering. */
.hatch-accessory {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 5;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}
.hatch-accessory img {
  width: 38%;
  height: 38%;
  object-fit: contain;
  margin-top: 8%;
}
/* Accessories that should sit lower (on body, not head) */
.hatch-accessory-scarf img,
.hatch-accessory-collar img,
.hatch-accessory-medal img,
.hatch-accessory-chain img,
.hatch-accessory-bandana img { margin-top: 30%; }
/* Wings + sparkle hover behind/around the dino */
.hatch-accessory-wings,
.hatch-accessory-sparkle {
  align-items: center;
}
.hatch-accessory-wings img,
.hatch-accessory-sparkle img {
  width: 60%;
  height: 60%;
  margin-top: 0;
}
/* Tail-bow sits at lower-back area */
.hatch-accessory-tail-bow {
  align-items: flex-end;
  justify-content: flex-end;
}
.hatch-accessory-tail-bow img {
  width: 25%;
  height: 25%;
  margin-top: 0;
  margin-right: 18%;
  margin-bottom: 22%;
}

@keyframes flicker {
  0%, 100% { opacity: 0.9; }
  33% { opacity: 0.5; }
  66% { opacity: 1; }
}
@keyframes zap {
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; }
}
@keyframes rainbow-shift {
  from { transform: translateY(0); }
  to { transform: translateY(24px); }
}
@keyframes aura-pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* ─── Rarity glow rings ─────────────────────────────────── */
.hatch-rarity-uncommon {
  box-shadow: inset 0 0 0 3px var(--neon-dim);
}
.hatch-rarity-rare {
  box-shadow:
    inset 0 0 0 3px var(--rare),
    inset 0 0 24px rgba(178,102,255,0.4);
  animation: rare-glow 2.5s ease-in-out infinite;
}
.hatch-rarity-legendary {
  box-shadow:
    inset 0 0 0 4px var(--legendary),
    inset 0 0 32px rgba(255,215,0,0.5);
  animation: legendary-glow 2s ease-in-out infinite;
}

@keyframes rare-glow {
  0%, 100% { box-shadow: inset 0 0 0 3px var(--rare), inset 0 0 24px rgba(178,102,255,0.4); }
  50% { box-shadow: inset 0 0 0 3px var(--rare), inset 0 0 40px rgba(178,102,255,0.7); }
}
@keyframes legendary-glow {
  0%, 100% { box-shadow: inset 0 0 0 4px var(--legendary), inset 0 0 32px rgba(255,215,0,0.5); }
  50% { box-shadow: inset 0 0 0 4px var(--legendary), inset 0 0 50px rgba(255,215,0,0.8); }
}

/* Holographic shimmer for legendaries (additional moving overlay) */
.hatch-shimmer {
  position: absolute;
  inset: 0;
  z-index: 4;
  pointer-events: none;
  background: linear-gradient(
    115deg,
    transparent 30%,
    rgba(255,215,0,0.15) 45%,
    rgba(255,255,255,0.3) 50%,
    rgba(178,102,255,0.15) 55%,
    transparent 70%
  );
  background-size: 250% 250%;
  animation: shimmer-move 3s linear infinite;
  mix-blend-mode: screen;
}
@keyframes shimmer-move {
  from { background-position: 100% 0; }
  to   { background-position: -100% 0; }
}

/* ═══════════════════════════════════════════════════════════
   DINO CARD (gallery item)
   ═══════════════════════════════════════════════════════════ */
.zone-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 14px;
}
.dino-card {
  background: var(--panel);
  border: 4px solid var(--neon-dim);
  cursor: pointer;
  transition: border-color 0.1s, transform 0.1s;
  display: flex;
  flex-direction: column;
  position: relative;
  text-decoration: none;
}
.dino-card:hover {
  border-color: var(--neon);
  background: var(--panel);
  transform: translate(-2px, -2px);
}
.dino-card .meta {
  padding: 10px 12px;
  border-top: 2px solid var(--neon-dim);
}
.dino-card .id {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--dim);
  letter-spacing: 1px;
  margin-bottom: 4px;
}
.dino-card .name {
  font-family: var(--serif);
  font-size: 12px;
  color: var(--text);
  letter-spacing: 1px;
  text-transform: uppercase;
}
.dino-card .stage-tag {
  position: absolute;
  top: 6px; right: 6px;
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 1px;
  padding: 3px 6px;
  background: var(--screen);
  color: var(--neon);
  border: 2px solid var(--neon);
  text-transform: uppercase;
  z-index: 10;
}
.dino-card .stage-tag.legendary {
  background: var(--legendary);
  color: var(--screen);
  border-color: var(--legendary);
}
.dino-card .stage-tag.incubating,
.dino-card .stage-tag.incubating-1,
.dino-card .stage-tag.incubating-2 {
  background: var(--screen);
  color: var(--amber);
  border-color: var(--amber);
}
.dino-card .rarity-tag {
  position: absolute;
  top: 6px; left: 6px;
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 1px;
  padding: 3px 6px;
  background: var(--screen);
  text-transform: uppercase;
  z-index: 10;
  border: 2px solid;
}
.rarity-tag.common { color: var(--dim); border-color: var(--dim); display: none; }
.rarity-tag.uncommon { color: var(--neon); border-color: var(--neon); }
.rarity-tag.rare { color: var(--rare); border-color: var(--rare); }
.rarity-tag.legendary { color: var(--legendary); border-color: var(--legendary); }

/* ═══════════════════════════════════════════════════════════
   HERO (homepage)
   ═══════════════════════════════════════════════════════════ */
.hero {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 40px;
  padding: 48px 0;
  align-items: center;
  border-bottom: 4px solid var(--neon);
}
@media (max-width: 880px) {
  .hero { grid-template-columns: 1fr; padding: 24px 0; gap: 24px; }
}
.hero h1 {
  font-family: var(--serif);
  font-size: clamp(28px, 5vw, 48px);
  color: var(--text);
  letter-spacing: 2px;
  line-height: 1.4;
  text-transform: uppercase;
}
.hero h1 .neon { color: var(--neon); }
.hero h1 .amber { color: var(--amber); }
.hero .tag {
  font-family: var(--serif);
  font-size: 10px;
  letter-spacing: 2.5px;
  color: var(--neon);
  margin-bottom: 16px;
  text-transform: uppercase;
}
.hero .lead {
  font-family: var(--body);
  font-size: 22px;
  color: var(--text);
  margin: 18px 0 24px;
  line-height: 1.5;
  max-width: 540px;
}
.hero .cta-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 28px;
}
.hero .stats-row {
  display: flex;
  gap: 32px;
  flex-wrap: wrap;
}
.hero .stat-mini .v {
  font-family: var(--serif);
  font-size: 22px;
  color: var(--text);
  letter-spacing: 1px;
}
.hero .stat-mini .v.neon { color: var(--neon); }
.hero .stat-mini .v.amber { color: var(--amber); }
.hero .stat-mini .l {
  font-family: var(--serif);
  font-size: 8px;
  letter-spacing: 2px;
  color: var(--dim);
  margin-top: 4px;
  text-transform: uppercase;
}

.hero .showcase {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 8px;
  aspect-ratio: 1.3;
}
.hero .showcase .featured {
  background: var(--screen);
  border: 4px solid var(--neon);
  position: relative;
  overflow: hidden;
}
.hero .showcase .featured .label {
  position: absolute;
  bottom: 8px; left: 12px; right: 12px;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--text);
  background: rgba(5,5,5,0.85);
  padding: 6px 8px;
  letter-spacing: 1px;
  border-top: 2px solid var(--neon);
  z-index: 20;
}
.hero .showcase .small-grid {
  display: grid;
  grid-template-rows: 1fr 1fr 1fr;
  gap: 8px;
}
.hero .showcase .small-grid .small {
  background: var(--screen);
  border: 4px solid var(--neon-dim);
  aspect-ratio: 1;
  overflow: hidden;
  position: relative;
}
.hero .showcase .small-grid .small .lbl {
  position: absolute;
  bottom: 4px; left: 6px; right: 6px;
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text);
  letter-spacing: 1px;
  background: rgba(5,5,5,0.85);
  padding: 2px 4px;
  z-index: 20;
}

/* ═══════════════════════════════════════════════════════════
   EXPLAINER
   ═══════════════════════════════════════════════════════════ */
.explainer {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin: 40px 0 24px;
}
@media (max-width: 880px) { .explainer { grid-template-columns: 1fr; } }
.explainer .col {
  border: 4px solid var(--neon);
  background: var(--screen);
  padding: 24px;
  position: relative;
}
.explainer .col .num {
  font-family: var(--serif);
  font-size: 10px;
  letter-spacing: 2.5px;
  color: var(--neon);
  margin-bottom: 12px;
  text-transform: uppercase;
}
.explainer .col h2 {
  font-family: var(--serif);
  font-size: 16px;
  color: var(--text);
  letter-spacing: 1.5px;
  margin-bottom: 14px;
  line-height: 1.4;
  text-transform: uppercase;
}
.explainer .col p {
  font-family: var(--body);
  font-size: 18px;
  color: var(--text);
  line-height: 1.4;
}

/* ═══════════════════════════════════════════════════════════
   FOOTER
   ═══════════════════════════════════════════════════════════ */
.footer {
  border-top: 4px solid var(--neon);
  padding: 32px 0 20px;
  margin-top: 48px;
}
.footer-inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 24px;
}
.footer-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  margin-bottom: 24px;
}
@media (max-width: 880px) { .footer-grid { grid-template-columns: repeat(2, 1fr); } }
.footer-col h4 {
  font-family: var(--serif);
  font-size: 9px;
  color: var(--neon);
  letter-spacing: 2px;
  margin-bottom: 12px;
  text-transform: uppercase;
}
.footer-col p, .footer-col a {
  font-family: var(--body);
  font-size: 16px;
  color: var(--dim);
  margin-bottom: 6px;
  display: block;
}
.footer-col a:hover { color: var(--neon); background: transparent; }
.footer-bar {
  border-top: 2px solid var(--neon-dim);
  padding-top: 14px;
  display: flex;
  gap: 18px;
  font-family: var(--mono);
  font-size: 10px;
  color: var(--dim);
  letter-spacing: 1px;
  flex-wrap: wrap;
  text-transform: uppercase;
}

/* ═══════════════════════════════════════════════════════════
   UTILITIES
   ═══════════════════════════════════════════════════════════ */
.spinner {
  display: inline-block;
  width: 14px; height: 14px;
  border: 2px solid var(--neon);
  border-top-color: transparent;
  margin-right: 8px;
  animation: spin 0.8s linear infinite;
  vertical-align: middle;
}
@keyframes spin { to { transform: rotate(360deg); } }

.empty-row {
  padding: 60px 24px;
  text-align: center;
  color: var(--dim);
  font-family: var(--serif);
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  grid-column: 1 / -1;
}

.neon { color: var(--neon); }
.amber { color: var(--amber); }
.rare { color: var(--rare); }
.legendary-c { color: var(--legendary); }
.dim { color: var(--dim); }
.text-mono { font-family: var(--mono); }

/* Skeleton loading state (replaces "LOADING…" with shimmer boxes) */
.skel {
  background: linear-gradient(90deg, #0a0a0a 25%, #1a1a1a 50%, #0a0a0a 75%);
  background-size: 200% 100%;
  animation: skel-shimmer 1.4s ease-in-out infinite;
}
@keyframes skel-shimmer {
  from { background-position: 200% 0; }
  to   { background-position: -200% 0; }
}

/* Trade page: side-button toggle */
.side-btn.active {
  background: var(--neon);
  color: var(--screen);
}
.side-btn:not(.active) {
  background: transparent;
  color: var(--neon);
}

/* ═══════════════════════════════════════════════════════════
   TERMS GATE (shown on every page load)
   ═══════════════════════════════════════════════════════════ */
body.gate-locked { overflow: hidden; }
body.gate-locked .topnav,
body.gate-locked .heartbeat,
body.gate-locked main,
body.gate-locked .footer {
  filter: blur(6px) brightness(0.4);
  pointer-events: none;
  user-select: none;
}

.hatch-gate {
  position: fixed;
  inset: 0;
  background: rgba(5, 5, 5, 0.96);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
  overflow-y: auto;
  /* CRT scanline overlay on the gate too */
  background-image:
    repeating-linear-gradient(
      0deg,
      rgba(0,0,0,0.3),
      rgba(0,0,0,0.3) 1px,
      transparent 1px,
      transparent 3px
    );
  background-color: rgba(5, 5, 5, 0.96);
  animation: gate-fade-in 0.3s ease-out;
}
.hatch-gate.closing {
  animation: gate-fade-out 0.25s ease-in forwards;
}
.hatch-gate.closed { display: none; }

@keyframes gate-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes gate-fade-out {
  from { opacity: 1; }
  to   { opacity: 0; }
}

.hatch-gate-inner {
  background: var(--screen);
  border: 4px solid var(--neon);
  max-width: 640px;
  width: 100%;
  padding: 32px 28px 24px;
  position: relative;
  box-shadow:
    0 0 0 1px var(--neon-low),
    0 8px 0 var(--neon-low),
    0 0 80px rgba(0, 255, 102, 0.18);
  max-height: 92vh;
  overflow-y: auto;
}

.hatch-gate-brand {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-bottom: 18px;
  padding-bottom: 18px;
  border-bottom: 4px solid var(--neon);
}
.hatch-gate-egg {
  width: 72px;
  height: 72px;
  image-rendering: pixelated;
  flex-shrink: 0;
  animation: egg-bob 2s ease-in-out infinite;
}
@keyframes egg-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}
.hatch-gate-tag {
  font-family: var(--serif);
  font-size: 9px;
  letter-spacing: 2.5px;
  color: var(--neon);
  margin-bottom: 6px;
  text-transform: uppercase;
}
.hatch-gate-title {
  font-family: var(--serif);
  font-size: 22px;
  letter-spacing: 2px;
  color: var(--text);
  text-transform: uppercase;
  line-height: 1.3;
}

.hatch-gate-lead {
  font-family: var(--body);
  font-size: 19px;
  color: var(--text);
  line-height: 1.5;
  margin-bottom: 20px;
}

.hatch-gate-section-tag {
  font-family: var(--serif);
  font-size: 9px;
  letter-spacing: 2.5px;
  color: var(--neon);
  margin-bottom: 10px;
  text-transform: uppercase;
}

.hatch-gate-terms {
  border: 2px solid var(--neon-dim);
  padding: 14px 16px;
  margin-bottom: 18px;
  background: rgba(0, 255, 102, 0.02);
}
.hatch-gate-terms ul {
  list-style: none;
  padding: 0;
}
.hatch-gate-terms li {
  font-family: var(--body);
  font-size: 17px;
  color: var(--text);
  line-height: 1.45;
  padding: 6px 0;
  border-bottom: 1px solid var(--neon-low);
}
.hatch-gate-terms li:last-child { border-bottom: none; }
.hatch-gate-terms li .neon { margin-right: 6px; }

.hatch-gate-social {
  margin-bottom: 18px;
}
.hatch-gate-x {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border: 3px solid var(--neon);
  background: var(--bg);
  text-decoration: none;
  transition: all 0.1s;
}
.hatch-gate-x:hover {
  background: var(--neon);
  color: var(--screen);
}
.hatch-gate-x:hover .hatch-gate-x-logo,
.hatch-gate-x:hover .hatch-gate-x-text,
.hatch-gate-x:hover .hatch-gate-x-arrow {
  color: var(--screen);
}
.hatch-gate-x-logo {
  font-size: 24px;
  color: var(--text);
  font-weight: bold;
  line-height: 1;
}
.hatch-gate-x-text {
  font-family: var(--serif);
  font-size: 11px;
  letter-spacing: 2px;
  color: var(--neon);
  flex: 1;
  text-transform: uppercase;
}
.hatch-gate-x-arrow {
  font-family: var(--mono);
  font-size: 16px;
  color: var(--neon);
}

.hatch-gate-actions {
  display: flex;
  justify-content: center;
  margin-bottom: 18px;
}
.hatch-gate-accept {
  font-size: 13px;
  padding: 16px 36px;
  letter-spacing: 3px;
}

.hatch-gate-fineprint {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--dim);
  letter-spacing: 1.5px;
  text-align: center;
  text-transform: uppercase;
  border-top: 2px solid var(--neon-low);
  padding-top: 14px;
}

/* Top nav X icon */
.nav-x {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 2px solid var(--neon-dim);
  color: var(--neon);
  font-size: 16px;
  font-weight: bold;
  text-decoration: none;
  transition: all 0.1s;
}
.nav-x:hover {
  background: var(--neon);
  color: var(--screen);
  border-color: var(--neon);
}

@media (max-width: 600px) {
  .hatch-gate { padding: 12px 8px; }
  .hatch-gate-inner { padding: 24px 18px 18px; }
  .hatch-gate-brand { gap: 14px; }
  .hatch-gate-egg { width: 56px; height: 56px; }
  .hatch-gate-title { font-size: 16px; }
  .hatch-gate-lead { font-size: 17px; }
  .hatch-gate-terms li { font-size: 15px; }
  .hatch-gate-accept { font-size: 11px; padding: 14px 28px; }
}

/* ═══════════════════════════════════════════════════════════
   X LINK (top nav)
   ═══════════════════════════════════════════════════════════ */
.x-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border: 2px solid var(--neon-dim);
  color: var(--neon-dim);
  transition: color 0.1s, border-color 0.1s, background 0.1s;
  text-decoration: none;
}
.x-link:hover {
  color: var(--screen);
  background: var(--neon);
  border-color: var(--neon);
}

/* ─── Modals ─────────────────────────────────────────── */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(5, 5, 5, 0.92);
  z-index: 99998;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
  overflow-y: auto;
}
.modal.open { display: flex; }
.modal-inner {
  background: var(--bg, #0a0a0a);
  border: 4px solid var(--neon);
  max-width: 440px;
  width: 100%;
  padding: 28px 24px;
  max-height: 92vh;
  overflow-y: auto;
}
.modal-title {
  font-family: var(--serif);
  font-size: 14px;
  letter-spacing: 1.5px;
  color: var(--neon);
  text-transform: uppercase;
  margin: 0 0 16px;
}
.modal-close {
  background: transparent;
  border: 2px solid var(--neon-dim);
  color: var(--text);
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1px;
  padding: 8px 14px;
  cursor: pointer;
  text-transform: uppercase;
  margin-top: 16px;
  width: 100%;
}
.modal-close:hover { border-color: var(--neon); color: var(--neon); }

/* Wallet picker buttons */
.wallet-picker-btn {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  background: transparent;
  border: 3px solid var(--neon-dim);
  padding: 14px 16px;
  margin-bottom: 10px;
  cursor: pointer;
  font-family: var(--serif);
  font-size: 12px;
  letter-spacing: 1.5px;
  color: var(--text);
  text-transform: uppercase;
  transition: border-color 0.1s, color 0.1s;
}
.wallet-picker-btn:hover { border-color: var(--neon); color: var(--neon); }
.wallet-picker-icon {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  background: var(--neon-dim);
  border-radius: 4px;
  object-fit: cover;
}
.wallet-picker-name { flex: 1; text-align: left; }

/* Multi-wallet linked list on /me */
.linked-wallets {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 18px;
}
.linked-wallet-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px;
  border: 2px solid var(--neon-dim);
  font-family: var(--mono);
  font-size: 11px;
  color: var(--text);
  letter-spacing: 1px;
}
.linked-wallet-chip.active { border-color: var(--neon); color: var(--neon); }
.linked-wallet-chip button {
  background: transparent;
  border: none;
  color: var(--danger);
  font-family: var(--mono);
  font-size: 14px;
  cursor: pointer;
  padding: 0 4px;
  line-height: 1;
}
.linked-wallet-chip button:hover { opacity: 0.7; }

.add-wallet-row {
  display: flex;
  gap: 8px;
  margin-bottom: 18px;
}
.add-wallet-row input {
  flex: 1;
  background: transparent;
  border: 3px solid var(--neon-dim);
  padding: 10px 12px;
  font-family: var(--mono);
  font-size: 12px;
  color: var(--text);
  letter-spacing: 1px;
}
.add-wallet-row input:focus {
  outline: none;
  border-color: var(--neon);
}
.add-wallet-row button {
  background: transparent;
  border: 3px solid var(--neon);
  color: var(--neon);
  font-family: var(--serif);
  font-size: 11px;
  letter-spacing: 1.5px;
  padding: 10px 16px;
  cursor: pointer;
  text-transform: uppercase;
}
.add-wallet-row button:hover { background: var(--neon); color: var(--bg); }

/* ─── Full-art mode (pre-rendered per-slot sprites) ─── */
/* When a /art/dinos-full/{slotId}.png exists, the renderer shows a single
   image that fills the frame. No layering, no overlays — the AI baked
   everything (body, pattern, accessory, scenery, eyes) into one sprite. */
.hatch-fullart {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  image-rendering: pixelated;
  image-rendering: -moz-crisp-edges;
  image-rendering: crisp-edges;
}

/* ─── INTERIM CLEAN-RENDER (during art-gen transition) ──
   Hide layered accessories, patterns, and aura overlays while we generate
   the trait library. Once new art is deployed, these will be either:
   - baked into the variant sprite (patterns)
   - properly sized + positioned (accessories — already fixed but hidden for now)
   - or no longer used for legendary (full art)
   Remove this block AFTER the new trait library deploys.
*/
.hatch-pattern,
.hatch-accessory,
.hatch-aura-fx {
  display: none !important;
}
/* Keep legendary shimmer — it's harmless and adds polish */
.hatch-shimmer {
  /* unchanged */
}

/* ─── HOLDER RANK CHIPS ───────────────────────────────── */
.rank-chip {
  display: inline-block;
  padding: 4px 10px;
  border: 2px solid currentColor;
  font-family: var(--serif);
  font-size: 10px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  font-weight: 700;
}
.rank-hatchling { color: var(--dim); }
.rank-nester    { color: var(--neon); }
.rank-apex      { color: var(--rare,    #b266ff); }
.rank-legend    { color: var(--amber); animation: shimmer-pulse 1.5s ease-in-out infinite alternate; }

@keyframes shimmer-pulse {
  0%   { text-shadow: 0 0 4px currentColor; }
  100% { text-shadow: 0 0 12px currentColor, 0 0 20px currentColor; }
}

.val.rank-hatchling { font-size: 22px; }
.val.rank-nester    { font-size: 22px; }
.val.rank-apex      { font-size: 22px; }
.val.rank-legend    { font-size: 22px; }

/* ─── ETH LINK SECTION ────────────────────────────────── */
.eth-link-row {
  margin-bottom: 14px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--neon-dim);
}
.eth-link-row:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}
.eth-link-sol {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--amber);
  letter-spacing: 1px;
  margin-bottom: 6px;
}
.eth-link-controls {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}
.eth-link-controls input {
  flex: 1;
  min-width: 280px;
  padding: 8px 12px;
  background: var(--screen);
  border: 2px solid var(--neon-dim);
  color: var(--text);
